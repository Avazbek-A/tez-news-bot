# Copy to .env (git-ignored) for local dev, or set these in your host's
# environment (e.g. Railway variables) for deployment.

# --- Required ---
# Telegram bot token from @BotFather.
BOT_TOKEN=123456789:replace-with-your-token

# --- Durable state (IMPORTANT for deployment) ---
# Where history.db + user_settings.json are stored. Point this at a
# mounted persistent volume so a redeploy doesn't wipe state. Defaults to
# the package directory (fine for local dev, EPHEMERAL on most hosts).
# Example for a Railway volume mounted at /data:
# DATA_DIR=/data

# --- Operational alerting (recommended) ---
# Telegram chat that receives 🚨 alerts (scraper breakage, error spikes).
# Get the value by sending /chatid to the bot.
# ALERT_CHAT_ID=123456789

# --- Optional integrations ---
# Enables /translate + /summarize (LLM via Groq). Without it those degrade
# gracefully. Note: the free tier is not licensed for commercial use.
# GROQ_API_KEY=
# GROQ_MODEL=

# Error tracking.
# SENTRY_DSN=

# Uptime heartbeat (healthchecks.io / cronitor URL).
# HEARTBEAT_URL=

# --- Logging ---
# LOG_LEVEL=INFO
# LOG_FORMAT=human   # or "json" for structured logs
