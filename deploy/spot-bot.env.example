# Read by the spot-bot systemd service (EnvironmentFile=/etc/spot-bot.env).
# Install:  sudo cp deploy/spot-bot.env.example /etc/spot-bot.env
#           sudo nano /etc/spot-bot.env      # fill in the values
#           sudo chmod 600 /etc/spot-bot.env # contains secrets
#
# NOTE: systemd EnvironmentFile syntax is KEY=value — no `export`, no
# surrounding quotes, '#' starts a comment.

# --- Required ---
BOT_TOKEN=123456789:replace-with-your-token

# --- Durable state: keep on a stable path so updates/reboots don't lose it ---
DATA_DIR=/var/lib/spot-bot

# --- Recommended ---
# Telegram chat that receives 🚨 alerts. Send /chatid to the bot to get it.
ALERT_CHAT_ID=

# --- Optional integrations ---
GROQ_API_KEY=
SENTRY_DSN=
HEARTBEAT_URL=

# --- Logging ---
LOG_FORMAT=json
LOG_LEVEL=INFO

# Optional: keep the downloaded Supertonic TTS model on the persistent
# path too (otherwise it lives in the service user's ~/.cache).
# HF_HOME=/var/lib/spot-bot/hf
